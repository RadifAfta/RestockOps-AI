NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug

# PostgreSQL Database Connection
DATABASE_URL=postgres://postgres:postgres@localhost:5432/restockops_ai
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=restockops_ai
DB_SSL=false
DB_MAX_CONNECTIONS=20

# AI / OpenAI Provider
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# WhatsApp Gateway (mock for local dev, meta for production)
WA_ADAPTER=mock
WA_VERIFY_TOKEN=restockops_verify_token
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
