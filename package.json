{
  "name": "restockops-ai",
  "version": "1.0.0",
  "description": "B2B SaaS Agent for Automated Restock Predictions & WhatsApp Outreach",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate:latest": "tsx src/database/migrator.ts latest",
    "migrate:down": "tsx src/database/migrator.ts down",
    "demo": "tsx src/scripts/seed-and-demo.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "restock",
    "inventory-prediction",
    "fastify",
    "kysely",
    "postgresql",
    "ai-agent"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/sensible": "^5.6.0",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "kysely": "^0.27.4",
    "openai": "^7.4.0",
    "pg": "^8.12.0",
    "pino": "^9.2.0",
    "pino-pretty": "^11.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.0",
    "typescript": "^5.5.2",
    "vitest": "^1.6.0"
  }
}
